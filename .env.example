# Public API
API_ORIGIN=http://localhost:5173
PORT=8787

# PostgreSQL
DATABASE_URL=

# Admin console
ADMIN_TOKEN=

# AI provider: local | openai | gemini
AI_VENDOR=openai
AI_API_KEY=
AI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Knowledge retrieval
# keyword is the zero-cost default. semantic enables OpenAI embeddings with a small in-memory cache.
AI_RETRIEVAL=keyword
AI_EMBEDDING_MODEL=text-embedding-3-small

# CRM: none | hubspot | webhook
CRM_PROVIDER=none
HUBSPOT_ACCESS_TOKEN=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Lead notifications
RESEND_API_KEY=
LEAD_NOTIFICATION_TO=
LEAD_NOTIFICATION_FROM=Aivanta <hello@aivanta.ai>
